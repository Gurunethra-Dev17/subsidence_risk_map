# Public, synthetic fixture mode is the default.
VITE_MOCK_MODE=true
# Enable with VITE_MOCK_MODE=false to require matching real Delhi metadata and API-scored cells.
VITE_REQUIRE_REAL_DELHI=false
# Same-origin path or an absolute URL including the /api/v1 prefix.
VITE_API_URL=/api/v1
# For a real Delhi map, match the value from the approved API's /meta data_vintage.
VITE_DELHI_DATA_VINTAGE=
# Optional plain-text ward-source credit from the delivered C0/C5 manifests.
VITE_DELHI_MAP_ATTRIBUTION=
# Approved 250-ward Delhi 2022 GeoJSON. Preferred when both ward sources are set.
VITE_WARDS_GEOJSON_URL=
# Optional base directory for gzip per-ward fallbacks named <ward_id>.json.
VITE_WARD_GEOJSON_FALLBACK_URL=
# Shell-only opt-in for npm run dev:e9 or test:e9 with the loopback E7 artifact server.
# Leave disabled for regular development and public builds.
VITE_E7_INTERNAL_PREVIEW=false
# Versioned C5 URLs with the wards, cells, and points source layers respectively.
VITE_WARDS_TILE_URL=
VITE_CELLS_TILE_URL=
VITE_POINTS_TILE_URL=
# OpenFreeMap Bright provides the default light street basemap.
VITE_BASEMAP_ENABLED=true
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
# Optional raster XYZ template with {z}, {x}, and {y} and required attribution.
VITE_BASEMAP_TILE_URL=
VITE_BASEMAP_ATTRIBUTION=
