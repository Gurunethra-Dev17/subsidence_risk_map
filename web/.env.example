# Public, synthetic fixture mode is the default.
VITE_MOCK_MODE=true
# Same-origin path or an absolute URL including the /api/v1 prefix.
VITE_API_URL=/api/v1
# Optional public URLs. Use a C5 archive with the wards source layer.
VITE_WARDS_TILE_URL=
VITE_CELLS_TILE_URL=
VITE_POINTS_TILE_URL=
# OpenFreeMap Bright provides the default light street basemap.
VITE_BASEMAP_ENABLED=true
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
# Optional raster XYZ template with {z}, {x}, and {y} and required attribution.
VITE_BASEMAP_TILE_URL=
VITE_BASEMAP_ATTRIBUTION=
