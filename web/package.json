{
  "name": "subsidence-risk-map-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --strictPort",
    "dev:live": "vite --strictPort --host localhost --port 5173 --mode c11",
    "dev:delhi": "vite --strictPort --port 5173 --mode delhi-preview",
    "dev:e9": "vite --strictPort --port 5173 --mode delhi-e9",
    "generate:types": "node scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "pretest": "node scripts/build-live-test.mjs",
    "test": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:delhi": "playwright test --config playwright.delhi.config.ts",
    "test:e9": "playwright test --config playwright.e9.config.ts",
    "verify:assets": "node scripts/verify-assets.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --strictPort"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "maplibre-gl": "^6.19.0",
    "pmtiles": "^4.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@maplibre/maplibre-gl-style-spec": {
      "@mapbox/jsonlint-lines-primitives": "2.0.2"
    }
  }
}
